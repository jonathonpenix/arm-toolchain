{
    "args": {
        "common": {
            "TARGET_ARCH": "armv7a",
            "VARIANT": "armv7a_soft_neon",
            "COMPILE_FLAGS": "-mfloat-abi=softfp -march=armv7a -mthumb -mfpu=neon -mno-unaligned-access",
            "ENABLE_EXCEPTIONS": "OFF",
            "ENABLE_RTTI": "ON",
            "TEST_EXECUTOR": "qemu",
            "QEMU_MACHINE": "none",
            "QEMU_CPU": "cortex-a7",
            "QEMU_PARAMS": "-m 1G",
            "BOOT_FLASH_ADDRESS": "0x00000000",
            "BOOT_FLASH_SIZE": "0x1000",
            "FLASH_ADDRESS": "0x20000000",
            "FLASH_SIZE": "0x1000000",
            "RAM_ADDRESS": "0x21000000",
            "RAM_SIZE": "0x1000000",
            "STACK_SIZE": "4K",
            "LIBRARY_BUILD_TYPE": "release"
        },
        "musl-embedded": {
            "ENABLE_CXX_LIBS": "ON",
            "ENABLE_LIBC_TESTS": "OFF",
            "ENABLE_COMPILER_RT_TESTS": "OFF",
            "ENABLE_LIBCXX_TESTS": "OFF"
        }
    }
}
